{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "stokker/pos-signature",
    "description": "Touch and mouse signature capture screen for Stokker POS.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Stokker\\PosSignature\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Stokker\\PosSignature\\PosSignatureServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
